# The dashboard picks the API origin at runtime from the current hostname:
#   - on localhost / *.local  → VITE_API_LOCAL_URL
#   - online (any other host) → VITE_API_BASE_URL
# Each is the backend origin; the app appends /api/admin itself.
VITE_API_LOCAL_URL=http://akwab.local
VITE_API_BASE_URL=https://api.akwab.store
